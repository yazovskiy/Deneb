<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <RestorePackagesWithLockFile>true</RestorePackagesWithLockFile>
    <!-- Publishing adds runtime/linker dependencies; keep normal restore reproducible. -->
    <NuGetLockFilePath Condition="'$(PublishSingleFile)' == 'true' and '$(RuntimeIdentifier)' != ''">$(MSBuildProjectDirectory)/packages.$(RuntimeIdentifier).publish.lock.json</NuGetLockFilePath>
  </PropertyGroup>
</Project>
